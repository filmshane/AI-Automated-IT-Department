---
# AutomationAI — Host inventory spreadsheet
- name: Collect host inventory facts
  hosts: linux
  gather_facts: true
  become: false
  tasks:
    - name: Collect disk information
      shell: |
        df -h --output=target,size,avail 2>/dev/null | tail -n +2 | grep -E '^/' | awk '{print $1":"$3}' \
        || df -h | awk 'NR>1 && $6 ~ /^\// {print $6":"$4}'
      register: disk_info
      changed_when: false
    - name: Build host data structure
      set_fact:
        host_data:
          hostname: "{{ inventory_hostname }}"
          os_type: "{{ ansible_distribution }} {{ ansible_distribution_version }}"
          total_memory: "{{ (ansible_memtotal_mb / 1024) | round(2) }} GB"
          memory_free: "{{ (ansible_memfree_mb / 1024) | round(2) }} GB"
          cpu_count: "{{ ansible_processor_vcpus | default(ansible_processor_count) }}"
          cpu_type: "{{ ansible_processor[2] if ansible_processor | length > 2 else ansible_processor[0] }}"
          ip_addresses: "{{ ansible_all_ipv4_addresses | join(', ') }}"
          disks: "{{ disk_info.stdout_lines | join('; ') }}"
          customer: "{{ customer_code | default('lab') }}"
    - name: Aggregate on control node
      delegate_to: localhost
      delegate_facts: true
      set_fact:
        all_hosts: "{{ all_hosts | default([]) + [host_data] }}"

- name: Create Excel spreadsheet
  hosts: localhost
  gather_facts: false
  become: false
  vars:
    report_path: "{{ playbook_dir }}/../files/reports/inventory-{{ lookup('pipe', 'date +%Y-%m-%d') }}.xlsx"
  tasks:
    - name: Ensure reports dir
      file:
        path: "{{ playbook_dir }}/../files/reports"
        state: directory
    - name: Ensure openpyxl
      pip:
        name: openpyxl
        state: present
    - name: Write generator script
      copy:
        dest: /tmp/aai_create_host_report.py
        content: |
          from openpyxl import Workbook
          from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
          hosts = {{ all_hosts | default([]) | to_json }}
          wb = Workbook(); ws = wb.active; ws.title = "Host Inventory"
          headers = ["Customer","Hostname","OS Type","Total Memory","Memory Free","CPU Count","CPU Type","IP Addresses","Disks"]
          fill = PatternFill(start_color="4472C4", end_color="4472C4", fill_type="solid")
          font = Font(bold=True, color="FFFFFF")
          border = Border(left=Side(style='thin'), right=Side(style='thin'), top=Side(style='thin'), bottom=Side(style='thin'))
          for col, h in enumerate(headers, 1):
              c = ws.cell(1, col, h); c.fill=fill; c.font=font; c.border=border
          for r, host in enumerate(hosts, 2):
              vals = [host.get('customer',''), host.get('hostname',''), host.get('os_type',''), host.get('total_memory',''),
                      host.get('memory_free',''), host.get('cpu_count',''), host.get('cpu_type',''), host.get('ip_addresses',''), host.get('disks','')]
              for col, v in enumerate(vals, 1):
                  cell = ws.cell(r, col, v); cell.border=border
          out = r"{{ report_path }}"; wb.save(out); print(out)
    - name: Run generator
      command: python3 /tmp/aai_create_host_report.py
      register: excel_result
    - debug:
        msg: "{{ excel_result.stdout }}"
